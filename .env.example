# Google Places API (New) — sunucu tarafı anahtarları.
# Bu değerleri .env.local dosyasına kopyalayıp doldurun; .env.local git'e girmez.
# NEXT_PUBLIC_ ön eki KULLANMAYIN, aksi hâlde anahtar tarayıcıya gönderilir.

# Google Cloud Console > APIs & Services > Credentials üzerinden oluşturulur.
# "Places API (New)" etkinleştirilmeli ve anahtar API kısıtlaması ile sınırlandırılmalıdır.
GOOGLE_PLACES_API_KEY=

# İşletmenin Google Place ID değeri (ChIJ... ile başlar).
GOOGLE_PLACE_ID=
